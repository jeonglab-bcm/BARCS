n <- 800
control <- rep(c(TRUE, FALSE), each = n / 2)
guides <- data.frame(
  gene = c(rep("NTC", n / 2), rep(sprintf("g\%03d", 1:200), each = 2)),
  estimate = rt(n, df = 3) / 4,
  std_error = 0.25
)
guides$estimate[n - 1:2] <- 3
guides$p_value <- 2 * pnorm(-abs(guides$estimate / guides$std_error))

